{
  "name": "mamaplus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @mamaplus/web --filter @mamaplus/api dev",
    "dev:web": "pnpm --filter @mamaplus/web dev",
    "dev:api": "pnpm --filter @mamaplus/api dev",
    "build": "pnpm --filter @mamaplus/database generate && pnpm --filter @mamaplus/api build && pnpm --filter @mamaplus/web build",
    "lint": "pnpm --filter @mamaplus/web lint",
    "start": "pnpm --filter @mamaplus/web start",
    "db:generate": "pnpm --filter @mamaplus/database generate",
    "db:seed": "pnpm --filter @mamaplus/database seed",
    "db:seed-courses": "pnpm --filter @mamaplus/database seed-courses",
    "db:seed-blog": "pnpm --filter @mamaplus/database seed-blog",
    "db:studio": "pnpm --filter @mamaplus/database studio",
    "db:check-passwords": "pnpm --filter @mamaplus/database check-passwords",
    "db:fix-passwords": "pnpm --filter @mamaplus/database fix-passwords"
  }
}
